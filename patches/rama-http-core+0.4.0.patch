+        if increment == 0 {
+            return Err(Reason::PROTOCOL_ERROR);
+        }
+        let target = self
+            .flow
+            .window_size()
+            .checked_add(self.in_flight_data)
+            .and_then(|window| window.checked_add(increment))
             .filter(|target| *target <= proto::MAX_WINDOW_SIZE)
             .ok_or(Reason::FLOW_CONTROL_ERROR)?;
-        self.set_target_connection_window(target, task)
+        self.set_target_connection_window(target, task)?;
+        self.flow.inc_window(increment)
     }
 
