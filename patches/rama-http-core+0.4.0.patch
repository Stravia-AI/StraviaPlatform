diff --git a/src/h2/early_frame_tests.rs b/src/h2/early_frame_tests.rs
new file mode 100644
index 0000000..76536b7
--- /dev/null
+++ b/src/h2/early_frame_tests.rs
@@ -0,0 +1,151 @@
+use rama_core::{
+    bytes::Bytes,
+    extensions::{Extensions, ExtensionsRef},
+};
+use rama_http_types::{
+    Request,
+    proto::h2::frame::{EarlyFrame, Priority, StreamDependency, StreamId, WindowUpdate},
+};
+use std::{
+    pin::Pin,
+    task::{Context, Poll},
+};
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, DuplexStream, ReadBuf};
+
+struct Io(DuplexStream, Extensions);
+impl ExtensionsRef for Io {
+    fn extensions(&self) -> &Extensions {
+        &self.1
+    }
+}
+impl AsyncRead for Io {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        b: &mut ReadBuf<'_>,
+    ) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_read(cx, b)
+    }
+}
+impl AsyncWrite for Io {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        b: &[u8],
+    ) -> Poll<std::io::Result<usize>> {
+        Pin::new(&mut self.0).poll_write(cx, b)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_shutdown(cx)
+    }
+}
+
+async fn replay(idle: bool) -> Result<(), Box<dyn std::error::Error>> {
+    let (socket, mut peer) = tokio::io::duplex(4096);
+    let mut builder = super::client::Builder::new();
+    let priority_stream = if idle { 3 } else { 1 };
+    builder.set_initial_window_size(100_000);
+    builder.set_early_frames(vec![
+        EarlyFrame::WindowUpdate(WindowUpdate::new(StreamId::zero(), 123)),
+        EarlyFrame::WindowUpdate(WindowUpdate::new(StreamId::zero(), 456)),
+        EarlyFrame::Priority(Priority::new(
+            StreamId::from(priority_stream),
+            StreamDependency::new(StreamId::zero(), 201, true),
+        )),
+    ]);
+    let (mut sender, connection) = builder
+        .handshake::<_, Bytes>(Io(socket, Extensions::new()))
+        .await?;
+    let response = if idle {
+        None
+    } else {
+        Some(
+            sender
+                .send_request(Request::builder().uri("https://localhost/").body(())?, true)?
+                .0,
+        )
+    };
+    let mut driver = tokio::spawn(connection);
+    let observe = async {
+        let mut preface = [0; 24];
+        peer.read_exact(&mut preface).await?;
+        assert_eq!(&preface, b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n");
+        peer.write_all(&[0, 0, 0, 4, 0, 0, 0, 0, 0]).await?;
+        let mut windows = Vec::new();
+        loop {
+            let mut frame = [0; 9];
+            peer.read_exact(&mut frame).await?;
+            let length = (usize::from(frame[0]) << 16)
+                | (usize::from(frame[1]) << 8)
+                | usize::from(frame[2]);
+            let mut body = vec![0; length];
+            peer.read_exact(&mut body).await?;
+            match frame[3] {
+                4 if frame[4] & 1 == 0 => peer.write_all(&[0, 0, 0, 4, 1, 0, 0, 0, 0]).await?,
+                8 => windows.push(u32::from_be_bytes(body.as_slice().try_into()?)),
+                2 => {
+                    assert_eq!(windows, [123, 456]);
+                    assert_eq!(frame, [0, 0, 5, 2, 0, 0, 0, 0, priority_stream as u8]);
+                    assert_eq!(body, [128, 0, 0, 0, 201]);
+                    break;
+                }
+                1 => panic!("application headers overtook configured early frames"),
+                _ => {}
+            }
+        }
+        if let Some(response) = response {
+            peer.write_all(&[0, 0, 1, 1, 4, 0, 0, 0, 1, 0x88]).await?;
+            let payload = [0x5a; 16_384];
+            let mut remaining = 66_000usize;
+            while remaining != 0 {
+                let size = remaining.min(payload.len());
+                remaining -= size;
+                peer.write_all(&[
+                    0,
+                    (size >> 8) as u8,
+                    size as u8,
+                    0,
+                    u8::from(remaining == 0),
+                    0,
+                    0,
+                    0,
+                    1,
+                ])
+                .await?;
+                peer.write_all(&payload[..size]).await?;
+            }
+            let mut body = response.await?.into_body();
+            let mut received = 0;
+            while let Some(chunk) = body.data().await {
+                let chunk = chunk?;
+                assert!(chunk.iter().all(|b| *b == 0x5a));
+                received += chunk.len();
+                body.flow_control().release_capacity(chunk.len())?;
+            }
+            assert_eq!(received, 66_000);
+        }
+        Ok::<_, Box<dyn std::error::Error>>(())
+    };
+    tokio::select! {
+        result = tokio::time::timeout(std::time::Duration::from_secs(10), observe) => { result??; },
+        result = &mut driver => { panic!("H2 driver ended before replay completed: {result:?}"); }
+    }
+    driver.abort();
+    // The driver is deliberately cancelled after the wire and flow-control assertions.
+    let _ = driver.await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn early_frames_preserve_order_and_cumulative_receive_credit()
+-> Result<(), Box<dyn std::error::Error>> {
+    replay(false).await
+}
+#[tokio::test]
+async fn priority_on_idle_stream_does_not_wait_for_stream_creation()
+-> Result<(), Box<dyn std::error::Error>> {
+    replay(true).await
+}
