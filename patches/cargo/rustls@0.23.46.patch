+    #[test]
+    fn full_handshake_succeeds_without_psk_modes_and_resumption_fails_closed() {
+        use crate::server::{ServerConfig, ServerConnection};
+        let provider = Arc::new(super::provider::default_provider());
+        let mut config = ClientConfig::builder_with_provider(provider.clone())
+            .with_protocol_versions(&[&version::TLS13]).unwrap()
+            .with_root_certificates(roots()).with_no_client_auth();
+        config.client_hello_shape = Some(Arc::new(ClientHelloShape {
+            omit_extensions: vec![45], ..ClientHelloShape::default()
+        }));
+        let config = Arc::new(config);
+        let certificates = vec![
+            CertificateDer::from(&include_bytes!("../../../test-ca/rsa-2048/end.der")[..]),
+            CertificateDer::from(&include_bytes!("../../../test-ca/rsa-2048/inter.der")[..]),
+        ];
+        let key = PrivateKeyDer::from_pem_reader(
+            &mut include_bytes!("../../../test-ca/rsa-2048/end.key").as_slice(),
+        ).unwrap();
+        let server_config = Arc::new(ServerConfig::builder_with_provider(provider)
+            .with_protocol_versions(&[&version::TLS13]).unwrap()
+            .with_no_client_auth().with_single_cert(certificates, key).unwrap());
+        let mut client = ClientConnection::new(config.clone(), ServerName::try_from("localhost").unwrap()).unwrap();
+        let mut server = ServerConnection::new(server_config.clone()).unwrap();
+        let mut first = Vec::new();
+        client.write_tls(&mut first).unwrap();
+        assert!(!parse_wire_client_hello(&first).extensions.iter().any(|(typ, _)| *typ == 45));
+        server.read_tls(&mut first.as_slice()).unwrap();
+        server.process_new_packets().unwrap();
+        for _ in 0..20 {
+            let mut to_client = Vec::new();
+            while server.wants_write() { server.write_tls(&mut to_client).unwrap(); }
+            if !to_client.is_empty() { client.read_tls(&mut to_client.as_slice()).unwrap(); client.process_new_packets().unwrap(); }
+            let mut to_server = Vec::new();
+            while client.wants_write() { client.write_tls(&mut to_server).unwrap(); }
+            if !to_server.is_empty() { server.read_tls(&mut to_server.as_slice()).unwrap(); server.process_new_packets().unwrap(); }
+            if !client.is_handshaking() && !server.is_handshaking() && !server.wants_write() && !client.wants_write() { break; }
+        }
+        assert!(!client.is_handshaking() && !server.is_handshaking());
+        // A full handshake without psk_key_exchange_modes may not receive a ticket.
+        // Seed a ticket through a separate, ordinary full handshake sharing the store.
+        let mut ordinary = (*config).clone();
+        ordinary.client_hello_shape = None;
+        let mut client = ClientConnection::new(Arc::new(ordinary), ServerName::try_from("localhost").unwrap()).unwrap();
+        let mut server = ServerConnection::new(server_config).unwrap();
+        for _ in 0..20 {
+            let mut to_server = Vec::new();
+            while client.wants_write() { client.write_tls(&mut to_server).unwrap(); }
+            if !to_server.is_empty() { server.read_tls(&mut to_server.as_slice()).unwrap(); server.process_new_packets().unwrap(); }
+            let mut to_client = Vec::new();
+            while server.wants_write() { server.write_tls(&mut to_client).unwrap(); }
+            if !to_client.is_empty() { client.read_tls(&mut to_client.as_slice()).unwrap(); client.process_new_packets().unwrap(); }
+            if !client.is_handshaking() && !server.is_handshaking() && !server.wants_write() && !client.wants_write() { break; }
+        }
+        assert!(!client.is_handshaking() && !server.is_handshaking());
+        assert!(ClientConnection::new(config, ServerName::try_from("localhost").unwrap()).is_err());
+    }
