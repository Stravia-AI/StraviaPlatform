+    #[cfg(feature = "tls12")]
+    #[test]
+    fn client_rejects_encrypt_then_mac_server_response() {
+        fn server_hello_result(response: u16, selected_suite: CipherSuite) -> Result<(), Error> {
+            let mut config = ClientConfig::builder_with_provider(super::provider::default_provider().into())
+                .with_protocol_versions(&[&version::TLS12]).unwrap()
+                .with_root_certificates(roots()).with_no_client_auth();
+            let mut suites: Vec<_> = config.crypto_provider().cipher_suites.iter().map(|suite| suite.suite()).collect();
+            suites.push(CipherSuite::Unknown(0xdead));
+            config.client_hello_shape = Some(Arc::new(ClientHelloShape {
+                cipher_suites: Some(suites),
+                raw_extensions: vec![RawExtension { typ: 22, data: vec![] }, RawExtension { typ: 18, data: vec![] }],
+                ..ClientHelloShape::default()
+            }));
+            let config = Arc::new(config);
+            let mut conn = ClientConnection::new(config.clone(), ServerName::try_from("localhost").unwrap()).unwrap();
+            let mut sent = Vec::new();
+            conn.write_tls(&mut sent).unwrap();
+            let sh = Message {
+                version: ProtocolVersion::TLSv1_2,
+                payload: MessagePayload::handshake(HandshakeMessagePayload(
+                    HandshakePayload::ServerHello(ServerHelloPayload {
+                        random: Random::new(config.provider.secure_random).unwrap(),
+                        compression_method: Compression::Null,
+                        cipher_suite: selected_suite,
+                        legacy_version: ProtocolVersion::TLSv1_2,
+                        session_id: SessionId::empty(),
+                        extensions: Box::new(ServerExtensions {
+                            extended_master_secret_ack: Some(()),
+                            ..ServerExtensions::default()
+                        }),
+                    }),
+                )),
+            };
+            let mut wire = sh.into_wire_bytes();
+            if response != 0 {
+                // The empty-session-id ServerHello has its extensions length here.
+                let ext_len_pos = 9 + 2 + 32 + 1 + 2 + 1;
+                let data: &[u8] = if response == 18 { &[0, 3, 0, 1, 1] } else { &[] };
+                let ext_len = u16::from_be_bytes([wire[ext_len_pos], wire[ext_len_pos + 1]]) + 4 + data.len() as u16;
+                wire[ext_len_pos..ext_len_pos + 2].copy_from_slice(&ext_len.to_be_bytes());
+                wire.extend_from_slice(&response.to_be_bytes());
+                wire.extend_from_slice(&(data.len() as u16).to_be_bytes());
+                wire.extend_from_slice(data);
+                let record_len = (wire.len() - 5) as u16;
+                wire[3..5].copy_from_slice(&record_len.to_be_bytes());
+                let handshake_len = wire.len() - 9;
+                wire[6] = (handshake_len >> 16) as u8;
+                wire[7] = (handshake_len >> 8) as u8;
+                wire[8] = handshake_len as u8;
+            }
+            conn.read_tls(&mut wire.as_slice()).unwrap();
+            conn.process_new_packets().map(|_| ())
+        }
+        let supported = CipherSuite::TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256;
+        assert!(server_hello_result(0, supported).is_ok());
+        assert!(server_hello_result(18, supported).is_ok());
+        assert!(server_hello_result(22, supported).is_err());
+        assert_eq!(server_hello_result(0, CipherSuite::Unknown(0xdead)), Err(PeerMisbehaved::SelectedUnofferedCipherSuite.into()));
+    }
