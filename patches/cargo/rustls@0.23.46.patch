+    #[cfg(feature = "tls12")]
+    #[test]
+    fn client_hello_shape_boringssl_padding_is_zero_filled() {
+        fn config(padding: PaddingPolicy, alpn_len: usize) -> ClientConfig {
+            let mut config = ClientConfig::builder_with_provider(super::provider::default_provider().into())
+                .with_protocol_versions(&[&version::TLS12]).unwrap()
+                .with_root_certificates(roots()).with_no_client_auth();
+            config.alpn_protocols = if alpn_len <= 255 {
+                vec![vec![b'a'; alpn_len]]
+            } else {
+                vec![vec![b'a'; 255], vec![b'b'; alpn_len - 255]]
+            };
+            config.client_hello_shape = Some(Arc::new(ClientHelloShape {
+                padding: Some(padding), ..ClientHelloShape::default()
+            }));
+            config
+        }
+        let (alpn_len, unpadded) = (1..=255).find_map(|len| {
+            let hello = wire_client_hello(config(PaddingPolicy::None, len)).unwrap();
+            (256..=508).contains(&hello.handshake_len).then_some((len, hello))
+        }).expect("a TLS 1.2 ClientHello should fit the padding window");
+        assert!(!unpadded.extensions.iter().any(|(typ, _)| *typ == 21));
+        let padded = wire_client_hello(config(PaddingPolicy::BoringSsl, alpn_len)).unwrap();
+        assert_eq!(padded.handshake_len, 512);
+        let padding = padded.extensions.iter().find(|(typ, _)| *typ == 21).unwrap();
+        assert_eq!(padding.1.len(), 512 - unpadded.handshake_len - 4);
+        assert!(padding.1.iter().all(|byte| *byte == 0));
+        for (target, expected) in [(254, 254), (256, 512), (511, 516), (512, 512)] {
+            let alpn_len = (1..=510).find(|len| {
+                wire_client_hello(config(PaddingPolicy::None, *len)).unwrap().handshake_len == target
+            }).expect("TLS 1.2 ClientHello must reach the boundary by varying ALPN length");
+            let hello = wire_client_hello(config(PaddingPolicy::BoringSsl, alpn_len)).unwrap();
+            assert_eq!(hello.handshake_len, expected, "unpadded length {target}");
+            let padding = hello.extensions.iter().find(|(typ, _)| *typ == 21);
+            assert_eq!(padding.is_some(), target == 256 || target == 511);
+            if let Some((_, data)) = padding {
+                assert!(data.iter().all(|byte| *byte == 0));
+            }
+        }
+    }
