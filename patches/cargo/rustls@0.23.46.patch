new file mode 100644
index 0000000..1f2f968
--- /dev/null
+++ b/src/client/hello_shape.rs
@@ -0,0 +1,107 @@
+use alloc::vec::Vec;
+
+use crate::{CipherSuite, ClientConfig, Error, NamedGroup};
+
+/// Controls the wire shape of a ClientHello without changing cryptographic implementations.
+#[derive(Clone, Debug, Default)]
+pub struct ClientHelloShape {
+    /// Ordered wire cipher suites. Unimplemented suites may be advertised but cannot be negotiated.
+    pub cipher_suites: Option<Vec<CipherSuite>>,
+    /// Ordered wire groups; advertised-only groups cannot be negotiated.
+    pub supported_groups: Option<Vec<NamedGroup>>,
+    /// Preferred extension order. Extensions arising dynamically are appended in their normal order.
+    pub extension_order: Option<Vec<u16>>,
+    /// Optional nonessential extensions to omit: status_request (5) and
+    /// psk_key_exchange_modes (45). Omitting 45 fails if PSK or early data is offered.
+    pub omit_extensions: Vec<u16>,
+    /// Additional safe, non-negotiating extension bodies.
+    pub raw_extensions: Vec<RawExtension>,
+    /// Optional ClientHello padding policy.
+    pub padding: Option<PaddingPolicy>,
+    /// Secure renegotiation indication.
+    pub renegotiation: Renegotiation,
+    /// Wire EC point formats (must contain uncompressed, format 0).
+    pub ec_point_formats: Option<Vec<u8>>,
+}
+
+/// A complete extension body, without its type and length prefix.
+#[derive(Clone, Debug)]
+pub struct RawExtension {
+    /// IANA extension type.
+    pub typ: u16,
+    /// Extension body.
+    pub data: Vec<u8>,
+}
+
+/// ClientHello padding behavior.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PaddingPolicy {
+    /// Follow the BoringSSL interoperability padding rule.
+    BoringSsl,
+    /// Do not add padding.
+    None,
+}
+
+/// Secure renegotiation signaling behavior.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Renegotiation {
+    /// Preserve rustls's default signaling.
+    #[default]
+    Default,
+    /// Signal using the SCSV cipher suite.
+    Scsv,
+    /// Signal using the renegotiation_info extension.
+    Extension,
+    /// Do not signal secure renegotiation.
+    Omit,
+}
+
+impl ClientHelloShape {
+    /// Reject incompatible and unsafe combinations before sending a ClientHello.
+    pub fn validate(&self, config: &ClientConfig, ech: bool) -> Result<(), Error> {
+        let bad = || Error::General("invalid ClientHello shape".into());
+        if ech || config.ech_mode.is_some() { return Err(bad()); }
+        if let Some(suites) = &self.cipher_suites {
+            if suites.is_empty() || suites.len() > 32767 || suites.iter().enumerate().any(|(i, v)| suites[..i].contains(v))
+                || config.crypto_provider().cipher_suites.iter().any(|s| !suites.contains(&s.suite())) {
+                return Err(bad());
+            }
+            let scsv = suites.contains(&CipherSuite::TLS_EMPTY_RENEGOTIATION_INFO_SCSV);
+            if (self.renegotiation == Renegotiation::Scsv && !scsv)
+                || (matches!(self.renegotiation, Renegotiation::Extension | Renegotiation::Omit) && scsv) { return Err(bad()); }
+        }
+        if let Some(groups) = &self.supported_groups {
+            // The extension has a two-byte vector length inside a two-byte extension length.
+            if groups.is_empty() || groups.len() > 32766
+                || groups.iter().enumerate().any(|(i, v)| groups[..i].contains(v))
+                || config.crypto_provider().kx_groups.iter().any(|g| !groups.contains(&g.name())) {
+                return Err(bad());
+            }
+        }
+        if self.omit_extensions.iter().enumerate().any(|(i, typ)| !matches!(typ, 5 | 45) || self.omit_extensions[..i].contains(typ)) {
+            return Err(bad());
+        }
+        if let Some(order) = &self.extension_order {
+            if order.iter().enumerate().any(|(i, v)| order[..i].contains(v))
+                || order.iter().position(|v| *v == 41).is_some_and(|i| i + 1 != order.len()) {
+                return Err(bad());
+            }
+        }
+        if let Some(formats) = &self.ec_point_formats {
+            if formats.is_empty() || formats.len() > 255 || !formats.contains(&0) { return Err(bad()); }
+        }
+        for (i, ext) in self.raw_extensions.iter().enumerate() {
+            if self.raw_extensions[..i].iter().any(|e| e.typ == ext.typ) || ext.data.len() > u16::MAX as usize { return Err(bad()); }
+            let valid = match ext.typ {
+                // SCT and encrypt-then-MAC requests have empty bodies. A server's
+                // EtM response is rejected: rustls does not implement that mode.
+                18 | 22 => ext.data.is_empty(),
+                // signature_algorithms_cert: a nonempty, even-length u16 vector.
+                50 => ext.data.len() >= 4 && u16::from_be_bytes([ext.data[0], ext.data[1]]) as usize == ext.data.len() - 2 && (ext.data.len() - 2) % 2 == 0,
+                _ => false,
+            };
+            if !valid { return Err(bad()); }
+        }
+        Ok(())
+    }
+}
