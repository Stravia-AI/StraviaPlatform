+    // Parse the wire rather than rustls's internal ClientHello representation: extension
+    // ordering, unknown extension bodies, and padding are observable at this boundary.
+    struct WireClientHello {
+        handshake_len: usize,
+        cipher_suites: Vec<u16>,
+        extensions: Vec<(u16, Vec<u8>)>,
+    }
+
+    fn wire_client_hello(config: ClientConfig) -> Result<WireClientHello, Error> {
+        let mut conn = ClientConnection::new(
+            Arc::new(config),
+            ServerName::try_from("localhost").unwrap(),
+        )?;
+        let mut wire = Vec::new();
+        conn.write_tls(&mut wire).unwrap();
+        Ok(parse_wire_client_hello(&wire))
+    }
+
+    fn parse_wire_client_hello(wire: &[u8]) -> WireClientHello {
+        assert_eq!(wire[0], 22); // handshake record
+        let record_len = u16::from_be_bytes([wire[3], wire[4]]) as usize;
+        assert_eq!(record_len + 5, wire.len());
+        assert_eq!(wire[5], 1); // ClientHello
+        let body_len = ((wire[6] as usize) << 16) | ((wire[7] as usize) << 8) | wire[8] as usize;
+        assert_eq!(body_len + 4, record_len);
+        let mut pos = 9 + 2 + 32; // handshake header, legacy_version, random
+        let session_len = wire[pos] as usize;
+        pos += 1 + session_len;
+        let suites_len = u16::from_be_bytes([wire[pos], wire[pos + 1]]) as usize;
+        pos += 2;
+        let cipher_suites = wire[pos..pos + suites_len]
+            .chunks_exact(2)
+            .map(|s| u16::from_be_bytes([s[0], s[1]]))
+            .collect();
+        pos += suites_len;
+        let compression_len = wire[pos] as usize;
+        pos += 1 + compression_len;
+        let extensions_len = u16::from_be_bytes([wire[pos], wire[pos + 1]]) as usize;
+        pos += 2;
+        let end = pos + extensions_len;
+        assert_eq!(end, wire.len());
+        let mut extensions = Vec::new();
+        while pos < end {
+            let typ = u16::from_be_bytes([wire[pos], wire[pos + 1]]);
+            let len = u16::from_be_bytes([wire[pos + 2], wire[pos + 3]]) as usize;
+            pos += 4;
+            extensions.push((typ, wire[pos..pos + len].to_vec()));
+            pos += len;
+        }
+        assert_eq!(pos, end);
+        WireClientHello { handshake_len: body_len + 4, cipher_suites, extensions }
+    }
