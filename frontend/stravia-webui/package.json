{
  "name": "stravia-webui",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "i18n:compile": "bun ./scripts/compile-i18n.ts",
    "i18n:check": "bun ./scripts/check-i18n-catalogs.ts",
    "dev": "bun run i18n:compile && bun --bun run vite",
    "dev:server": "bun run i18n:compile && bun ./scripts/dev-server.js",
    "build": "bun run i18n:compile && STRAVIA_WEBUI_DIST=dist bun --bun run vite build",
    "build:desktop-e2e": "bun run i18n:compile && STRAVIA_WEBUI_DIST=dist-desktop-e2e bun --bun run vite build --mode desktop-e2e",
    "check": "bun run i18n:check && bun run i18n:compile && bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json",
    "lint": "bun --bun run eslint .",
    "test:unit": "bun run i18n:compile && bun --bun run svelte-kit sync && bun test ./test",
    "test:e2e": "bun --bun run playwright test",
    "test:e2e:desktop": "wdio run ./wdio.desktop.conf.ts",
    "playwright:install": "bun --bun run playwright install",
    "format": "bun --bun run prettier --write --ignore-path .prettierignore .",
    "format:check": "bun --bun run prettier --check --ignore-path .prettierignore .",
    "preview": "bun --bun run vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/svelte-query": "^6.3.0",
    "@tanstack/svelte-table": "9.2.4",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@xyflow/svelte": "1.7.0",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.16",
    "eventsource-parser": "4.1.1",
    "layerchart": "^2.5.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.7.0",
    "style-to-object": "2.0.2",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "webdriverio": "^9.32.0"
  }
}
