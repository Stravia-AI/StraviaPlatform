{
  "name": "stravia-webui",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "i18n:compile": "bun ./scripts/compile-i18n.ts",
    "i18n:check": "bun ./scripts/check-i18n-catalogs.ts",
    "dev": "bun run i18n:compile && vite",
    "build": "bun run i18n:compile && vite build",
    "build:desktop-e2e": "bun run i18n:compile && vite build --mode desktop-e2e",
    "check": "bun run i18n:check && bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test:unit": "bun run i18n:compile && svelte-kit sync && bun test ./test",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "wdio run ./wdio.desktop.conf.ts",
    "playwright:install": "playwright install",
    "format": "prettier --write --ignore-path .prettierignore .",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.44",
    "@tanstack/svelte-table": "9.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "layerchart": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@inlang/paraglide-js": "2.24.1",
    "@inlang/plugin-message-format": "4.0.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.34.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.4",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.5.0",
    "style-to-object": "2.0.2",
    "svelte": "5.56.8",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "webdriverio": "^9.31.3"
  }
}
