{
  "name": "stravia-webui",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "i18n:compile": "bun ./scripts/compile-i18n.ts",
    "i18n:check": "bun ./scripts/check-i18n-catalogs.ts",
    "dev": "bun run i18n:compile && bun --bun run vite",
    "dev:server": "bun run i18n:compile && bun ./scripts/dev-server.js",
    "build": "bun run i18n:compile && STRAVIA_WEBUI_DIST=dist bun --bun run vite build",
    "build:desktop-e2e": "bun run i18n:compile && STRAVIA_WEBUI_DIST=dist-desktop-e2e bun --bun run vite build --mode desktop-e2e",
    "check": "bun run i18n:check && bun run i18n:compile && bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json",
    "lint": "bun --bun run eslint .",
    "test:unit": "bun run i18n:compile && bun --bun run svelte-kit sync && bun test --isolate ./test",
    "test:e2e": "bun --bun run playwright test",
    "test:e2e:desktop": "wdio run ./wdio.desktop.conf.ts",
    "playwright:install": "bun --bun run playwright install",
    "format": "bun --bun run prettier --write --ignore-path .prettierignore .",
    "format:check": "bun --bun run prettier --check --ignore-path .prettierignore .",
    "preview": "bun --bun run vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/svelte-query": "^6.4.7",
    "@tanstack/svelte-table": "9.3.2",
    "@tanstack/svelte-virtual": "^3.13.54",
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@xyflow/svelte": "2.0.3",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.5.0",
    "eventsource-parser": "4.1.3",
    "katex": "^0.19.1",
    "layerchart": "^2.12.0",
    "marked": "^18.3.0",
    "marked-cjk-friendly": "^0.1.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.2",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.80.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.108.4",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.10",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "shadcn-svelte": "^1.8.1",
    "style-to-object": "2.0.2",
    "svelte": "5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "webdriverio": "^9.33.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#webui-extensions": "./src/lib/extensions/ce-entry.ts"
  }
}
