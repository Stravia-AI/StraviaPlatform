set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "11.0" CACHE STRING "" FORCE)
if(DEFINED ENV{OSXCROSS_TARGET_DIR} AND DEFINED ENV{OSXCROSS_SDK_DIR})
  set(CMAKE_OSX_SYSROOT "$ENV{OSXCROSS_SDK_DIR}" CACHE PATH "" FORCE)
endif()
if(DEFINED ENV{CC_x86_64_apple_darwin})
  set(CMAKE_C_COMPILER "$ENV{CC_x86_64_apple_darwin}" CACHE FILEPATH "" FORCE)
endif()
if(DEFINED ENV{CXX_x86_64_apple_darwin})
  set(CMAKE_CXX_COMPILER "$ENV{CXX_x86_64_apple_darwin}" CACHE FILEPATH "" FORCE)
endif()
if(DEFINED ENV{AR_x86_64_apple_darwin})
  set(CMAKE_AR "$ENV{AR_x86_64_apple_darwin}" CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
