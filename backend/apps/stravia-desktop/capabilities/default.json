{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Bundled main WebView permissions; remote content receives no native API access",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",

    "opener:default",
    "allow-get-admin-session",
    "allow-get-server-port",
    "allow-get-desktop-port-state",
    "allow-set-desktop-fixed-port",
    "allow-recheck-desktop-fixed-port",
    "allow-set-desktop-external-access",
    "allow-get-desktop-client-settings",
    "allow-set-desktop-launch-at-login",
    "allow-set-desktop-silent-start",
    "allow-plan-connect-client",
    "allow-apply-connect-client",
    "allow-list-provider-allowances",
    "allow-refresh-provider-allowances",
    "allow-refresh-provider-allowance",
    "allow-get-desktop-update-state",
    "allow-download-product-update",
    "allow-install-product-update"
  ]
}
