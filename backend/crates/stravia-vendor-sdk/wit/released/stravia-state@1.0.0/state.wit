package stravia:state@1.0.0;

/// Operation-bound, host-scoped atomic state cells.
interface store {
    /// Provider state is bound to the admitted vendor and provider.
    /// Conversation state additionally belongs to the admitted lineage.
    enum scope { provider, conversation }

    /// Revision zero represents a cell that has never existed. Deletion leaves
    /// a tombstone with a fresh revision, preventing stale writes from succeeding.
    record snapshot {
        revision: u64,
        payload: option<list<u8>>,
    }

    /// Extensible error code and a message safe to expose to the guest.
    record error {
        code: string,
        message: string,
    }

    resource cell {
        load: func() -> result<snapshot, error>;
        /// Returns false only when the expected revision conflicts.
        compare-exchange: func(expected-revision: u64, payload: option<list<u8>>) -> result<bool, error>;
    }

    /// Keys are stable UTF-8 names of at most 128 bytes. Each scope supports
    /// at most 16 keys; each payload is limited to 64 KiB.
    open: func(scope: scope, key: string) -> result<cell, error>;
}
